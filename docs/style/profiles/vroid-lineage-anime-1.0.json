{
  "id": "vroid-lineage-anime",
  "version": "0.1.0",
  "title": "VRoid-lineage anime style profile",
  "description": "The de facto 'VRM anime' look as practised by VRoid Studio exports and hand-tuned derivatives: proportions as bone ratios and head counts, a three-tier MToon shading convention (face never deep-shadowed, body/cloth hard two-tone, hair softer two-tone), inverted-hull outlines on surfaces but not on facial features, layered translucent eye materials, spring-bone hair, and a VRoid-typical performance budget. Envelopes are measured from the corpus below; fingerprint rules record tool constants and are informational only.",
  "corpus": {
    "n": 22,
    "effective_n": 18,
    "note": "Local assets measured 2026-09-10 with scripts/style_lint.py. Re-exports of the same VRoid body (AvatarSample_A 0.0/1.0; VRoid_V110_Female, AvatarBlondeRedDress and VRM1_Constraint_Twist_Sample; AvatarSample_V and The President) collapse to effective_n. Two synthetic generator outputs from ../vrm-conformance (smoke_default.vrm, springbone_default.vrm) were used as negative controls and are not in the corpus.",
    "assets": [
      "AvatarSample_A_1.0.vrm.glb", "AvatarSample_A_0.0.vrm.glb", "AvatarSample_B.vrm", "AvatarSample_H_1.0.vrm", "AvatarSample_K_1.0.vrm",
      "AvatarSample_O_1.0.vrm", "AvatarSample_U_1.0.vrm.glb", "AvatarSample_V_1.0.vrm", "AvatarBlondeRedDress_1.0.vrm", "vroid_default_F_1_0.vrm",
      "VRoid_V110_Female_v1.1.3.vrm", "VRoid_V110_Male_v1.1.3.vrm", "VRM1_Constraint_Twist_Sample.vrm", "AliciaSolid.vrm", "AnnieV0.vrm",
      "PompaGirl_v0.vrm", "Vita_clothing.vrm", "5824032820619220341.vrm", "Alex Scott (Heroes All).vrm", "Chinese Space Commander.vrm",
      "Mike Scott (Heroes All).vrm", "The President.vrm"
    ]
  },
  "metric_definitions": {
    "asset.height_m": "max Y of all mesh positions in rest pose minus min(0, bbox min Y). Skinned meshes are taken in bind space (VRM rest == bind).",
    "proportions.eye_height_ratio": "mean world Y of leftEye/rightEye humanoid bones divided by height.",
    "proportions.hips_height_ratio": "hips bone Y / height.",
    "proportions.upper_leg_height_ratio": "leftUpperLeg bone Y / height.",
    "proportions.shoulder_width_ratio": "distance leftUpperArm–rightUpperArm / height.",
    "proportions.ipd_m": "distance between leftEye and rightEye bones, metres.",
    "proportions.lower_upper_arm_ratio": "|lowerArm–hand| / |upperArm–lowerArm|, left side.",
    "proportions.lower_upper_leg_ratio": "|lowerLeg–foot| / |upperLeg–lowerLeg|, left side.",
    "proportions.arm_span_height_ratio": "distance leftHand–rightHand bones / height (hand bones, not fingertips).",
    "proportions.rest_pose_arm_horizontal_cos": "|x component| of the unit vector upperArm→hand in rest pose; 1.0 is a perfect T-pose.",
    "proportions.limb_asymmetry": "max over arm/leg of |left length − right length| / max(left, right).",
    "proportions.head_height_m": "Vertices whose dominant skin joint is head, leftEye, rightEye or jaw, restricted to the centre column |x − head.x| < 15 mm. chin = lowest such vertex with z > head.z (in front of the head bone); crown = highest such vertex. head_height = crown − chin. Includes crown hair and any neck skin weighted to head; does not depend on mesh or material names.",
    "proportions.head_count": "height / head_height_m.",
    "proportions.head_bone_fraction": "(head bone Y − chin) / head_height_m.",
    "proportions.eye_height_in_head": "(eye bone Y − chin) / head_height_m. 0.5 is the realistic vertical midpoint; anime faces sit lower.",
    "proportions.head_width_m": "X extent of head-dominant vertices within ±10 mm of eye height (includes hair over the temples).",
    "proportions.ipd_head_width_ratio": "ipd_m / head_width_m.",
    "proportions.head_width_height_ratio": "head_width_m / head_height_m.",
    "springs.hair_chains": "spring chains whose first joint is a descendant of the head bone.",
    "springs.head_colliders": "colliders attached to the head bone or a descendant.",
    "lookat.offset_y": "lookAt.offsetFromHeadBone[1] (VRM 1.0) or firstPersonBoneOffset.y (VRM 0.x).",
    "expressions.presets": "VRM 1.0 preset names present; VRM 0.x presetNames are mapped to their 1.0 equivalents (joy→happy, sorrow→sad, fun→relaxed, a/i/u/e/o→aa/ih/ou/ee/oh).",
    "material.shadow_end": "MToon 1.0 shading = linearstep(−1 + toony, 1 − toony, NdotL + shift). shadow_end = −1 + toony − shift: the NdotL below which the surface is fully in shade colour. −1 means never shaded; 0 means a terminator at grazing light.",
    "material.lit_start": "1 − toony − shift: NdotL above which the surface is fully lit.",
    "material.terminator_width": "lit_start − shadow_end = 2(1 − toony). 0 is a hard two-tone edge; 2 is a full Lambert gradient.",
    "material.shade_luminance_ratio": "Rec.709 luminance of shadeColorFactor / luminance of baseColorFactor (textures not sampled).",
    "material.shade_warmth": "(shade.r/shade.g) / (base.r/base.g); > 1 means the shade colour is redder than the base.",
    "material.outline_luminance": "luminance of outlineColorFactor (linear).",
    "material.outline_warm": "outlineColorFactor.r >= outlineColorFactor.b.",
    "material.outline_width_m": "outlineWidthFactor when outlineWidthMode == worldCoordinates, else null. VRM 0.x _OutlineWidth (cm) is converted ×0.01.",
    "material.rim_luminance": "luminance of parametricRimColorFactor.",
    "material.emissive_luminance": "luminance of emissiveFactor.",
    "material.*": "VRM 0.x MToon properties are converted to 1.0 space with the UniVRM/three-vrm migration formulas (shadingToony = lerp(_ShadeToony, 1, 0.5 + 0.5·_ShadeShift); shadingShift = −_ShadeShift − (1 − shadingToony)), matching VRMMToonMaterial.toMToonMaterial()."
  },
  "material_roles": {
    "roles": ["face_skin", "body_skin", "hair", "cloth", "accessory", "iris", "eye_white", "eye_highlight", "eyeline", "eyelash", "brow", "mouth", "other"],
    "groups": {
      "face_region": ["face_skin", "iris", "eye_white", "eye_highlight", "eyeline", "eyelash", "brow", "mouth"],
      "facial_feature": ["iris", "eye_white", "eye_highlight", "eyeline", "eyelash", "brow", "mouth"],
      "surface": ["face_skin", "body_skin", "cloth", "accessory"],
      "skin": ["face_skin", "body_skin"],
      "lit_cutout": ["body_skin", "cloth", "hair", "accessory"]
    }
  },
  "reference_tiers": {
    "vrchat_avatar_performance_ranks": {
      "source": "https://creators.vrchat.com/avatars/avatar-performance-ranking-system/ (fetched 2026-09-10)",
      "pc": { "excellent": { "triangles": 32000, "texture_memory_mb": 40, "skinned_meshes": 1, "material_slots": 4, "bones": 75, "physbone_components": 4, "physbone_transforms": 16, "physbone_colliders": 4 },
              "good": { "triangles": 70000, "texture_memory_mb": 75, "skinned_meshes": 2, "material_slots": 8, "bones": 150, "physbone_components": 8, "physbone_transforms": 64, "physbone_colliders": 8 },
              "medium": { "triangles": 70000, "texture_memory_mb": 110, "skinned_meshes": 8, "material_slots": 16, "bones": 256, "physbone_components": 16, "physbone_transforms": 128, "physbone_colliders": 16 },
              "poor": { "triangles": 70000, "texture_memory_mb": 150, "skinned_meshes": 16, "material_slots": 32, "bones": 400, "physbone_components": 32, "physbone_transforms": 256, "physbone_colliders": 32 } },
      "mobile": { "excellent": { "triangles": 7500, "texture_memory_mb": 10, "skinned_meshes": 1, "material_slots": 1, "bones": 75, "physbone_components": 0 },
                  "good": { "triangles": 10000, "texture_memory_mb": 18, "skinned_meshes": 1, "material_slots": 1, "bones": 90, "physbone_components": 4, "physbone_transforms": 16, "physbone_colliders": 4 },
                  "medium": { "triangles": 15000, "texture_memory_mb": 25, "skinned_meshes": 2, "material_slots": 2, "bones": 150, "physbone_components": 6, "physbone_transforms": 32, "physbone_colliders": 8 },
                  "poor": { "triangles": 20000, "texture_memory_mb": 40, "skinned_meshes": 2, "material_slots": 4, "bones": 150, "physbone_components": 8, "physbone_transforms": 64, "physbone_colliders": 16 } },
      "note": "Every corpus asset lands in VRChat PC 'Medium' or 'Poor' (16–24 material slots, 94–347 nodes, 137–222 MB decoded textures). The budget rules below encode the VRoid-typical envelope, not VRChat ranks."
    }
  },
  "rules": [
    { "id": "prop.eye_height_ratio", "class": "aesthetic", "severity": "must", "metric": "proportions.eye_height_ratio",
      "title": "Eyes sit in the top sixth of the figure", "check": { "type": "range", "min": 0.82, "max": 0.94 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.8433, "median": 0.8983, "max": 0.9243, "source": "corpus" } },
    { "id": "prop.hips_height_ratio", "class": "aesthetic", "severity": "must", "metric": "proportions.hips_height_ratio",
      "title": "Hips at 50–62% of height", "check": { "type": "range", "min": 0.50, "max": 0.62 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.538, "median": 0.5665, "max": 0.5811, "source": "corpus" } },
    { "id": "prop.upper_leg_height_ratio", "class": "aesthetic", "severity": "should", "metric": "proportions.upper_leg_height_ratio",
      "title": "Long legs: leg root above mid-height", "check": { "type": "range", "min": 0.48, "max": 0.58 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.5107, "median": 0.5415, "max": 0.5562, "source": "corpus" } },
    { "id": "prop.shoulder_width_ratio", "class": "aesthetic", "severity": "should", "metric": "proportions.shoulder_width_ratio",
      "title": "Narrow shoulders", "check": { "type": "range", "min": 0.07, "max": 0.20 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.0836, "median": 0.1341, "max": 0.1702, "source": "corpus" } },
    { "id": "prop.ipd_m", "class": "aesthetic", "severity": "should", "metric": "proportions.ipd_m",
      "title": "Eye-bone spacing 20–70 mm", "check": { "type": "range", "min": 0.02, "max": 0.07 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.0252, "median": 0.0307, "max": 0.0553, "source": "corpus", "note": "AliciaSolid is the 55 mm outlier." } },
    { "id": "prop.head_count", "class": "aesthetic", "severity": "should", "metric": "proportions.head_count",
      "title": "4.5–8 heads tall", "check": { "type": "range", "min": 4.5, "max": 8.0 },
      "rationale": "Realistic adults measure ~7.5–8 heads with a bare skull; this metric includes crown hair so anime figures land lower. Chibi (2–4 heads) is a different profile.",
      "provenance": { "n": 22, "effective_n": 18, "min": 5.058, "median": 6.599, "max": 7.473, "source": "corpus" } },
    { "id": "prop.eye_height_in_head", "class": "aesthetic", "severity": "should", "metric": "proportions.eye_height_in_head",
      "title": "Eyes below the head's vertical midpoint", "check": { "type": "range", "min": 0.25, "max": 0.50 },
      "rationale": "Large-eye anime construction places the eye line at roughly 35–40% of chin-to-crown; realistic construction places it at 50%.",
      "provenance": { "n": 22, "effective_n": 18, "min": 0.2787, "median": 0.3716, "max": 0.4491, "source": "corpus" } },
    { "id": "prop.head_width_height_ratio", "class": "aesthetic", "severity": "may", "metric": "proportions.head_width_height_ratio",
      "title": "Head width 65–110% of head height", "check": { "type": "range", "min": 0.65, "max": 1.10 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.7055, "median": 0.828, "max": 1.052, "source": "corpus", "note": "includes hair over the temples" } },
    { "id": "prop.ipd_head_width_ratio", "class": "aesthetic", "severity": "may", "metric": "proportions.ipd_head_width_ratio",
      "title": "Eye spacing 10–30% of head width", "check": { "type": "range", "min": 0.10, "max": 0.30 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.125, "median": 0.1516, "max": 0.2641, "source": "corpus" } },
    { "id": "prop.head_bone_fraction", "class": "aesthetic", "severity": "may", "metric": "proportions.head_bone_fraction",
      "title": "Head bone near the jaw line", "check": { "type": "range", "min": 0.0, "max": 0.30 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.0236, "median": 0.1324, "max": 0.2289, "source": "corpus" } },
    { "id": "prop.lower_upper_arm_ratio", "class": "aesthetic", "severity": "should", "metric": "proportions.lower_upper_arm_ratio",
      "title": "Forearm ≈ upper arm", "check": { "type": "range", "min": 0.80, "max": 1.20 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.8935, "median": 0.9764, "max": 1.137, "source": "corpus" } },
    { "id": "prop.lower_upper_leg_ratio", "class": "aesthetic", "severity": "should", "metric": "proportions.lower_upper_leg_ratio",
      "title": "Shin longer than thigh", "check": { "type": "range", "min": 1.00, "max": 1.30 },
      "provenance": { "n": 22, "effective_n": 18, "min": 1.117, "median": 1.17, "max": 1.187, "source": "corpus" } },
    { "id": "prop.arm_span_height_ratio", "class": "aesthetic", "severity": "should", "metric": "proportions.arm_span_height_ratio",
      "title": "Hand-to-hand span 55–78% of height", "check": { "type": "range", "min": 0.55, "max": 0.78 },
      "provenance": { "n": 22, "effective_n": 18, "min": 0.5923, "median": 0.6741, "max": 0.7226, "source": "corpus" } },
    { "id": "prop.height_m", "class": "aesthetic", "severity": "should", "metric": "asset.height_m",
      "title": "Life-scale figure", "check": { "type": "range", "min": 1.10, "max": 2.00 },
      "provenance": { "n": 22, "effective_n": 18, "min": 1.176, "median": 1.619, "max": 1.878, "source": "corpus" } },
    { "id": "prop.rest_pose_t", "class": "interop", "severity": "must", "metric": "proportions.rest_pose_arm_horizontal_cos",
      "title": "Rest pose is a T-pose", "check": { "type": "range", "min": 0.98 },
      "provenance": { "n": 22, "min": 0.9986, "median": 1.0, "max": 1.0, "source": "spec", "note": "VRMC_vrm humanoid requires T-pose rest; retargeting in VRMAnimationLoader assumes it." } },
    { "id": "prop.limb_symmetry", "class": "interop", "severity": "must", "metric": "proportions.limb_asymmetry",
      "title": "Left/right limb lengths match", "check": { "type": "range", "max": 0.02 },
      "provenance": { "n": 22, "min": 0, "median": 0, "max": 0, "source": "corpus" } },

    { "id": "shade.face_never_deep_shadowed", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["face_region"], "metric": "shadow_end",
      "title": "Face region is never fully in shade for front-facing light", "check": { "type": "range", "max": -0.6 },
      "rationale": "The headline anime rule: no nose or brow shadows. VRoid's 'toon' preset does it with shift +0.71 (fully lit above NdotL −0.62); its 'soft' preset with toony 0.05 (gradient spanning the whole hemisphere). Both leave the fully-shaded region behind the head.",
      "provenance": { "n": 158, "effective_n": 18, "min": -1.0, "median": -0.8, "max": 0.4833, "source": "corpus", "note": "158 face_region materials; 18/21 face_skin materials conform. PompaGirl, AnnieV0 and pixiv's constraint sample use plain toon faces." } },
    { "id": "shade.body_two_tone", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["body_skin", "cloth", "accessory"], "metric": "terminator_width",
      "title": "Body and clothing use a hard two-tone terminator", "check": { "type": "range", "max": 0.4 },
      "rationale": "toony ≥ 0.8. The soft-gradient VRoid preset (toony 0.2, width 1.6) is a recognised minority style and fails this rule by design.",
      "provenance": { "n": 146, "effective_n": 18, "min": 0.0, "median": 0.1, "max": 1.6, "source": "corpus", "note": "16/21 bodies conform." } },
    { "id": "shade.body_terminator_at_grazing", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["body_skin", "cloth", "accessory"], "metric": "shadow_end",
      "title": "Body shade begins at or behind grazing light", "check": { "type": "range", "min": -1.0, "max": 0.6 },
      "provenance": { "n": 146, "effective_n": 18, "min": -1.0, "median": 0.0, "max": 0.575, "source": "corpus" } },
    { "id": "shade.hair_softer_two_tone", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["hair"], "metric": "terminator_width",
      "title": "Hair terminator softer than body but not Lambert", "check": { "type": "range", "max": 1.4 },
      "provenance": { "n": 60, "effective_n": 18, "min": 0.0, "median": 0.4, "max": 1.3, "source": "corpus" } },
    { "id": "shade.hair_shadow_end", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["hair"], "metric": "shadow_end",
      "title": "Hair shade begins near grazing light", "check": { "type": "range", "max": 0.3 },
      "provenance": { "n": 60, "effective_n": 18, "min": -1.0, "median": 0.0, "max": 0.2167, "source": "corpus" } },
    { "id": "shade.skin_shade_warm", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["skin"], "metric": "shade_warmth",
      "title": "Skin shade colour is warmer (redder) than the base", "check": { "type": "range", "min": 1.0 },
      "provenance": { "n": 42, "effective_n": 18, "min": 1.0, "median": 1.193, "max": 1.491, "source": "corpus" } },
    { "id": "shade.skin_shade_not_dark", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["skin"], "metric": "shade_luminance_ratio",
      "title": "Skin shade luminance ≥ 60% of base", "check": { "type": "range", "min": 0.6, "max": 1.0 },
      "provenance": { "n": 42, "effective_n": 18, "min": 0.6951, "median": 0.86, "max": 1.0, "source": "corpus" } },
    { "id": "shade.cloth_shade_not_black", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["cloth", "hair"], "metric": "shade_luminance_ratio",
      "title": "Cloth and hair shade luminance ≥ 25% of base", "check": { "type": "range", "min": 0.25, "max": 1.0 },
      "provenance": { "n": 168, "effective_n": 18, "min": 0.2942, "median": 0.9076, "max": 1.0, "source": "corpus" } },
    { "id": "shade.rim_subtle", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["surface", "hair"], "metric": "rim_luminance",
      "title": "Parametric rim is off or subtle", "check": { "type": "range", "max": 0.3 },
      "provenance": { "n": 227, "effective_n": 18, "min": 0.0, "median": 0.0, "max": 0.5278, "source": "corpus" } },
    { "id": "shade.skin_no_emissive", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["skin", "cloth"], "metric": "emissive_luminance",
      "title": "Skin and cloth are not emissive", "check": { "type": "equals", "value": 0.0 },
      "provenance": { "n": 150, "effective_n": 18, "observed": "all 0", "source": "corpus", "note": "hair emissive is used deliberately (10/60 hair materials) and is not constrained." } },
    { "id": "roles.all_classified", "class": "interop", "severity": "should", "metric": "asset.unclassified_materials",
      "title": "Every material has a role", "check": { "type": "equals", "value": 0 },
      "rationale": "Material-scoped rules only see materials with a role. An unclassified material is silently exempt, so the report must say so; pass --roles to assign roles by name.",
      "provenance": { "n": 22, "observed": "19/22 assets 0; AliciaSolid 2, Vita_clothing 1", "source": "corpus" } },
    { "id": "shade.mtoon_everywhere", "class": "aesthetic", "severity": "should", "metric": "asset.non_mtoon_materials",
      "title": "Every material is MToon", "check": { "type": "equals", "value": 0 },
      "provenance": { "n": 22, "observed": "21/22 assets 0; AliciaSolid 6 non-MToon", "source": "corpus" } },

    { "id": "outline.surface_present", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["face_skin", "body_skin", "cloth"], "metric": "outlineWidthMode",
      "title": "Skin and cloth carry a world-space inverted-hull outline", "check": { "type": "equals", "value": "worldCoordinates" },
      "provenance": { "n": 150, "effective_n": 18, "observed": { "worldCoordinates": 150 }, "source": "corpus", "note": "accessories (cat ears, tails, glasses) are excluded; 5 of them ship without an outline." } },
    { "id": "outline.surface_width", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["face_skin", "body_skin", "cloth"], "filter": { "outlineWidthMode": "worldCoordinates" }, "metric": "outline_width_m",
      "title": "Outline width 0.3–3 mm", "check": { "type": "range", "min": 0.0003, "max": 0.003 },
      "provenance": { "n": 150, "effective_n": 18, "min": 0.000498, "median": 0.0008, "max": 0.0025, "source": "corpus" } },
    { "id": "outline.surface_dark", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["face_skin", "body_skin", "cloth"], "metric": "outline_luminance",
      "title": "Outline is dark", "check": { "type": "range", "max": 0.2 },
      "provenance": { "n": 150, "effective_n": 18, "min": 0.0202, "median": 0.0202, "max": 0.1319, "source": "corpus" } },
    { "id": "outline.surface_warm", "class": "aesthetic", "severity": "may", "scope": "material", "roles": ["face_skin", "body_skin", "cloth"], "metric": "outline_warm",
      "title": "Outline is warm-dark, not blue-black", "check": { "type": "equals", "value": true },
      "provenance": { "n": 150, "effective_n": 18, "observed": "150/150 true", "source": "corpus" } },
    { "id": "outline.facial_feature_none", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["facial_feature"], "metric": "outlineWidthMode",
      "title": "Eyes, brows, lashes and mouth have no outline", "check": { "type": "equals", "value": "none" },
      "provenance": { "n": 137, "effective_n": 18, "observed": "137/137 none", "source": "corpus" } },

    { "id": "alpha.cutout_surfaces", "class": "aesthetic", "severity": "should", "scope": "material", "roles": ["lit_cutout"], "metric": "alphaMode",
      "title": "Body, cloth and hair are cutout or opaque, never blended", "check": { "type": "enum", "values": ["MASK", "OPAQUE"] },
      "provenance": { "n": 206, "effective_n": 18, "observed": { "MASK": 196, "OPAQUE": 6, "BLEND": 4 }, "source": "corpus" } },
    { "id": "alpha.cutoff_half", "class": "aesthetic", "severity": "may", "scope": "material", "roles": ["lit_cutout", "face_skin"], "filter": { "alphaMode": "MASK" }, "metric": "alphaCutoff",
      "title": "Cutout threshold around 0.5", "check": { "type": "range", "min": 0.3, "max": 0.7 },
