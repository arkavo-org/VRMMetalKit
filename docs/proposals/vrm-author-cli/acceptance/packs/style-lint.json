      "id": "generator-string-noop",
      "description": "Overwrite glTF asset.generator on the U fixture. No rule reads it, so the grade must not move; the runner must still refuse the edited bytes as the pinned fixture.",
      "expectedClassification": "reject",
      "transform": {
        "kind": "metadata-noop",
        "fixture": "avatar-sample-u-1.0",
        "field": "asset.generator",
        "value": "acceptance-pack metadata-noop control"
