    {
      "id": "toon-face",
      "description": "test_toon_face_trips_face_rule_only: shadingShift -0.05 / shadingToony 0.95 on Face_00_SKIN pushes shadow_end above -0.6.",
      "expectedClassification": "reject",
      "transform": {
        "kind": "style-mutation:mtoon",
        "fixture": "avatar-sample-u-1.0",
        "materialNameContains": [
          "Face_00_SKIN"
        ],
        "changes": {
          "shadingShiftFactor": -0.05,
          "shadingToonyFactor": 0.95
        },
        "expectFlip": {
          "shade.face_never_deep_shadowed": "fail"
        },
        "expectUnchanged": [
          "shade.body_two_tone"
        ]
      }
    },
    {
      "id": "outlines-removed",
      "description": "test_removing_outlines_trips_outline_rule: outlineWidthMode none on every SKIN and CLOTH material.",
      "expectedClassification": "reject",
      "transform": {
        "kind": "style-mutation:mtoon",
        "fixture": "avatar-sample-u-1.0",
        "materialNameContains": [
          "SKIN",
          "CLOTH"
        ],
        "changes": {
          "outlineWidthMode": "none"
        },
        "expectFlip": {
          "outline.surface_present": "fail"
        },
        "expectUnchanged": [
          "shade.face_never_deep_shadowed"
        ]
      }
    },
    {
      "id": "blink-dropped",
      "description": "test_dropping_blink_trips_core_presets: remove the blink preset expression.",
      "expectedClassification": "reject",
      "transform": {
        "kind": "style-mutation:delete-path",
        "fixture": "avatar-sample-u-1.0",
        "path": "extensions.VRMC_vrm.expressions.preset.blink",
        "expectFlip": {
          "expr.core_presets": "fail"
        }
      }
    },
